{
  "version": 1,
  "idle": {
    "screensaver": 150,
    "lock": 300
  },
  "bar": {
    "position": "top",
    "transparent": false,
    "centerAnchor": "fedory.clock",
    "layout": {
      "left": [
        {
          "id": "fedory.menu"
        },
        {
          "id": "fedory.workspaces"
        }
      ],
      "center": [
        {
          "id": "fedory.indicators"
        },
        {
          "id": "fedory.clock",
          "format": "dddd HH:mm",
          "formatAlt": "d MMMM 'W'ww yyyy",
          "verticalFormat": "HH\n\u2014\nmm"
        },
        {
          "id": "fedory.weather"
        },
        {
          "id": "fedory.system-update"
        }
      ],
      "right": [
        {
          "id": "fedory.tray"
        },
        {
          "id": "fedory.model-usage"
        },
        {
          "id": "fedory.bluetooth"
        },
        {
          "id": "fedory.network"
        },
        {
          "id": "fedory.audio"
        },
        {
          "id": "fedory.monitor"
        },
        {
          "id": "fedory.power"
        }
      ]
    }
  },
  "plugins": []
}
