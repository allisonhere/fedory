[Unit]
Description=Fedory automatic tablet rotation
PartOf=graphical-session.target
After=graphical-session.target
ConditionPathExists=%h/.local/state/fedory/tablet/enabled

[Service]
ExecStart=/usr/bin/bash -lc 'exec "$FEDORY_PATH/bin/fedory-tablet-rotation-watch"'
Restart=on-failure
RestartSec=2

[Install]
WantedBy=graphical-session.target
