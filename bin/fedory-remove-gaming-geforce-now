#!/bin/bash

# fedory:summary=Remove the GeForce NOW Flatpak app and its data.
# fedory:group=remove
# fedory:name=gaming geforce-now

set -e

if fedory-cmd-present flatpak && flatpak info com.nvidia.geforcenow &>/dev/null; then
  flatpak uninstall -y --delete-data com.nvidia.geforcenow
fi

echo ""
echo "GeForce NOW removed."
