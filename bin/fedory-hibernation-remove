#!/bin/bash

# fedory:summary=Remove hibernation setup including swap and boot resume settings
# fedory:requires-sudo=true
#
# Fedora-native rewrite: see fedory-hibernation-setup for why this uses
# grubby + dracut instead of Limine + mkinitcpio.

if ! grubby --info=DEFAULT 2>/dev/null | grep -q 'resume='; then
  echo "Hibernation is not set up"
  exit 0
fi

if ! gum confirm "Remove hibernation setup?"; then
  exit 0
fi

SWAP_SUBVOLUME="/swap"
SWAP_FILE="$SWAP_SUBVOLUME/swapfile"

# Disable swap if active
if swapon --show | grep -q "$SWAP_FILE"; then
  echo "Disabling swap on $SWAP_FILE"
  sudo swapoff "$SWAP_FILE"
fi

# Remove swapfile
if [[ -f $SWAP_FILE ]]; then
  echo "Removing swapfile"
  sudo rm "$SWAP_FILE"
fi

# Remove swap subvolume
if sudo btrfs subvolume show "$SWAP_SUBVOLUME" &>/dev/null; then
  echo "Removing Btrfs subvolume $SWAP_SUBVOLUME"
  sudo btrfs subvolume delete "$SWAP_SUBVOLUME"
fi

# Remove fstab entry
if grep -Fq "$SWAP_FILE" /etc/fstab; then
  echo "Removing swapfile from /etc/fstab"
  sudo cp -a /etc/fstab "/etc/fstab.$(date +%Y%m%d%H%M%S).back"
  sudo sed -i "\|$SWAP_FILE|d" /etc/fstab
  sudo sed -i '/^# Btrfs swapfile for system hibernation$/d' /etc/fstab
fi

# Remove resume kernel parameters from every installed kernel's boot entry
echo "Removing resume kernel parameters"
resume_args=$(grubby --info=DEFAULT 2>/dev/null | grep -oE '(resume|resume_offset)=[^[:space:]"]+' || true)
if [[ -n $resume_args ]]; then
  # shellcheck disable=SC2086
  sudo grubby --update-kernel=ALL --remove-args="$(tr '\n' ' ' <<<"$resume_args")"
fi

echo "Regenerating initramfs..."
sudo dracut -f

echo "Hibernation removed"
