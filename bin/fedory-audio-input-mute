#!/bin/bash

# fedory:summary=Toggle microphone mute. Drives the hardware mic-mute LED on laptops that expose one.

wpctl set-mute @DEFAULT_AUDIO_SOURCE@ toggle >/dev/null

if wpctl get-volume @DEFAULT_AUDIO_SOURCE@ | grep -q MUTED; then
  fedory-brightness-keyboard-mute on
  fedory-osd -i microphone-muted -m "Microphone muted"
else
  fedory-brightness-keyboard-mute off
  fedory-osd -i microphone -m "Microphone on"
fi
