#!/bin/bash

# fedory:summary=List themes that can style the Plymouth boot screen
# fedory:examples=fedory plymouth list

{
  find ~/.config/fedory/themes/ -mindepth 1 -maxdepth 1 \( -type d -o -type l \) -printf '%f\n' 2>/dev/null
  find "$FEDORY_PATH/themes/" -mindepth 1 -maxdepth 1 -type d -printf '%f\n'
} | sort -u | while read -r name; do
  if [[ -f $(fedory-theme-dir "$name")/preview-unlock.png ]]; then
    echo "$name"
  fi
done
