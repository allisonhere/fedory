#!/bin/bash

# fedory:summary=Launch a URL as a web app in the default supported browser
# fedory:args=<url>

browser=$(env -u BROWSER xdg-settings get default-web-browser)

case $browser in
chromium.desktop | org.chromium.Chromium.desktop)
  exec setsid uwsm app -- flatpak run org.chromium.Chromium --app="$1" "${@:2}"
  ;;
google-chrome* | brave* | microsoft-edge* | opera* | vivaldi* | helium*) ;;
*)
  exec setsid uwsm app -- flatpak run org.chromium.Chromium --app="$1" "${@:2}"
  ;;
esac

browser_exec=$(sed -n 's/^Exec=\([^ ]*\).*/\1/p' \
  {~/.local,~/.nix-profile,/usr/local,/usr}/share/applications/"$browser" 2>/dev/null | head -1)
[[ -n $browser_exec ]] || {
  echo "Could not resolve browser desktop entry: $browser" >&2
  exit 1
}

exec setsid uwsm app -- "$browser_exec" --app="$1" "${@:2}"
