#!/bin/bash

# fedory:summary=Print the directory holding a theme, preferring a user-installed copy
# fedory:args=<theme-name>
# fedory:examples=fedory theme dir tokyo-night

theme="${1:-}"

if [[ -z $theme ]]; then
  echo "Usage: fedory-theme-dir <theme-name>" >&2
  exit 1
fi

if [[ -d $HOME/.config/fedory/themes/$theme ]]; then
  echo "$HOME/.config/fedory/themes/$theme"
else
  echo "$FEDORY_PATH/themes/$theme"
fi
