#!/bin/bash

# fedory:summary=Install a Nerd Font package and switch the system to it
# fedory:args=<display-name> <package> <family>
# fedory:examples=fedory install font 'Cascadia Mono' ttf-cascadia-mono-nerd 'CaskaydiaMono Nerd Font'

name="${1-}"
package="${2-}"
family="${3-}"

if [[ -z $name || -z $package || -z $family ]]; then
  echo "Usage: fedory-install-font <display-name> <package> <family>" >&2
  exit 1
fi

exec fedory-launch-floating-terminal-with-presentation \
  "echo 'Installing ${name}...'; fedory-pkg-add ${package} && sleep 2 && fedory-font-set '${family}'"
