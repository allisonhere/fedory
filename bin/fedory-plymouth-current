#!/bin/bash

# fedory:summary=Show which theme is styling the Plymouth boot screen
# fedory:examples=fedory plymouth current

# fedory-plymouth-set installs the theme's unlock.png as a byte-for-byte
# copy of logo.png, so matching it back identifies the current theme.
installed_logo=/usr/share/plymouth/themes/fedory/logo.png

if cmp -s "$FEDORY_PATH/default/plymouth/logo.png" "$installed_logo"; then
  echo default
  exit
fi

fedory-plymouth-list | while read -r name; do
  if cmp -s "$(fedory-theme-dir "$name")/unlock.png" "$installed_logo"; then
    echo "$name"
    exit
  fi
done
