#!/bin/bash

# fedory:summary=Launch the default editor selected via Fedory defaults.
# fedory:args=[--inline] <path>

default_editor="$HOME/.local/state/fedory/defaults/editor"

if [[ ${1:-} == "--inline" ]]; then
  inline=true
  shift
else
  inline=false
fi

if [[ -f $default_editor ]]; then
  read -r editor <"$default_editor"
else
  editor="nvim"
fi

fedory-cmd-present "$editor" || editor="nvim"

case "${editor##*/}" in
nvim | vim | nano | micro | hx | helix | fresh)
  if [[ $inline == "true" ]]; then
    exec "$editor" "$@"
  else
    exec fedory-launch-tui "$editor" "$@"
  fi
  ;;
*)
  exec setsid uwsm app -- "$editor" "$@"
  ;;
esac
