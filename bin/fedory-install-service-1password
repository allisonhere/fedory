#!/bin/bash

# fedory:summary=Install 1Password and its Chromium extension.
# fedory:requires-sudo=true
#
# Fedora-native rewrite: 1Password (AgileBits) publishes its own official
# dnf repo for Fedora/RHEL, same vendor-repo pattern as
# fedory-install-browser's Chrome/Edge/Brave.

set -e

EXTENSION_ID="aeblfdkhhhdcdjpifhhbdiojplfjncoa"
EXTENSION_DIR="/usr/share/chromium/extensions"
EXTENSION_FILE="$EXTENSION_DIR/$EXTENSION_ID.json"
WEBSTORE_UPDATE_URL="https://clients2.google.com/service/update2/crx"

install_chromium_extension() {
  # Fedora's Chromium ships via Flatpak (see packaging/README.md), which is
  # sandboxed from /usr/share -- this system-wide extension policy only
  # reaches a native, package-installed Chromium. Same caveat as
  # install/config/theme-system.sh's Chromium policy directory.
  if ! command -v chromium >/dev/null 2>&1 && ! flatpak info org.chromium.Chromium >/dev/null 2>&1; then
    echo "Chromium is not installed; skipping 1Password Chromium extension."
    return
  fi
  if ! command -v chromium >/dev/null 2>&1; then
    echo "Chromium is installed via Flatpak; the system-wide extension policy"
    echo "at $EXTENSION_DIR won't reach its sandbox. Install the 1Password"
    echo "extension manually from the Chrome Web Store instead."
    return
  fi

  sudo mkdir -p "$EXTENSION_DIR"
  printf '{ "external_update_url": "%s" }\n' "$WEBSTORE_UPDATE_URL" | sudo tee "$EXTENSION_FILE" >/dev/null
  sudo chmod 644 "$EXTENSION_FILE"
}

echo "Installing 1Password..."
sudo rpm --import https://downloads.1password.com/linux/keys/1password.asc
sudo dnf config-manager addrepo --id=1password --set=name="1Password" \
  --set=baseurl=https://downloads.1password.com/linux/rpm/stable/\$basearch \
  --set=enabled=1 --set=gpgcheck=1 --set=gpgkey=https://downloads.1password.com/linux/keys/1password.asc
sudo dnf install -y 1password 1password-cli

echo "Installing 1Password extension for Chromium..."
install_chromium_extension

echo "Opening 1Password..."
uwsm app -- 1password >/dev/null 2>&1 &

echo ""
echo "1Password has been installed. Restart Chromium to load the browser extension."
