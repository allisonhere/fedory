#!/bin/bash

# fedory:summary=List available themes
# fedory:examples=fedory theme list | fedory theme set "Tokyo Night"

{
  find ~/.config/fedory/themes/ -mindepth 1 -maxdepth 1 \( -type d -o -type l \) -printf '%f\n'
  find "$FEDORY_PATH/themes/" -mindepth 1 -maxdepth 1 -type d -printf '%f\n'
} | sort -u | sed -E 's/(^|-)([a-z])/\1\u\2/g; s/-/ /g'
