#!/bin/bash

# fedory:summary=Finalize Fedory user setup (runtime tweaks the skel seed can't do)
# fedory:group=finalize
# fedory:examples=fedory finalize user | fedory finalize user --force

set -euo pipefail

usage() {
  cat <<USAGE
Usage: fedory finalize user [--force] [--first-install]

Runs the per-user setup steps that a skel-style seed can't do:
dev-aware skill symlinks, xdg-user-dirs + gtk bookmarks (need \$HOME),
default browser/mailto, and install/user/all.sh.

For shipped user configs see install/user/config-seed.sh (run as part of
install/user/all.sh below -- non-destructive) and fedory-reinstall-configs
(existing users explicitly resyncing, destructive).

--first-install is used by bootstrap.sh on first install. It marks shipped
migrations complete for the freshly-bootstrapped user.

Idempotency marker: ~/.local/state/fedory/done/finalize-user
USAGE
}

if (( EUID == 0 )); then
  echo "Error: run fedory-finalize-user as the user being configured, not as root." >&2
  exit 1
fi

force=0
first_install=0
while (($#)); do
  case "$1" in
    --force)
      force=1
      shift
      ;;
    --first-install)
      first_install=1
      force=1
      shift
      ;;
    -h|--help)
      usage
      exit 0
      ;;
    *)
      echo "Unknown option: $1" >&2
      usage >&2
      exit 1
      ;;
  esac
done

state_dir="$HOME/.local/state/fedory"
mkdir -p "$state_dir"

if fedory-done check finalize-user && (( force == 0 )); then
  echo "User finalization already complete (rerun with --force to refresh)."
  exit 0
fi

export FEDORY_PATH="${FEDORY_PATH:-/usr/share/fedory}"
export FEDORY_INSTALL="${FEDORY_INSTALL:-$FEDORY_PATH/install}"
export FEDORY_SETUP_CONTEXT="${FEDORY_SETUP_CONTEXT:-runtime}"
export PATH="$FEDORY_PATH/bin:$PATH"

if (( first_install )); then
  export FEDORY_SETUP_CONTEXT=bootstrap
fi

if [[ -n ${FEDORY_INSTALL_LOG_FILE:-} && -f $FEDORY_INSTALL/helpers/logging.sh ]]; then
  source "$FEDORY_INSTALL/helpers/logging.sh"
else
  run_logged() {
    local script="$1"
    bash -eE -c 'source "$1"' bash "$script"
  }
fi

# Dev-aware skill symlinks. Cannot be baked into the static skel seed because
# FEDORY_PATH may point at a dev checkout (fedory dev link) where the target
# differs.
mkdir -p ~/.agents/skills ~/.claude/skills ~/.codex/skills ~/.pi/agent/skills
ln -sfn "$FEDORY_PATH/default/fedory-skill" ~/.agents/skills/fedory
ln -sfn "$FEDORY_PATH/default/fedory-skill" ~/.claude/skills/fedory
ln -sfn "$FEDORY_PATH/default/fedory-skill" ~/.codex/skills/fedory
ln -sfn "$FEDORY_PATH/default/fedory-skill" ~/.pi/agent/skills/fedory

mkdir -p ~/Downloads ~/Pictures ~/Videos ~/.config/gtk-3.0
xdg-user-dirs-update --set TEMPLATES "$HOME"
xdg-user-dirs-update --set PUBLICSHARE "$HOME"
xdg-user-dirs-update --set DESKTOP "$HOME"
rmdir ~/Templates ~/Public ~/Desktop 2>/dev/null || true
touch ~/.config/gtk-3.0/bookmarks
for dir in Downloads Projects Pictures Videos; do
  bookmark="file://$HOME/$dir $dir"
  grep -qxF "$bookmark" ~/.config/gtk-3.0/bookmarks || echo "$bookmark" >>~/.config/gtk-3.0/bookmarks
done

source "$FEDORY_INSTALL/user/all.sh"

fedory-refresh-applications
env -u BROWSER xdg-settings set default-web-browser chromium.desktop || true
xdg-mime default org.mozilla.Thunderbird.desktop x-scheme-handler/mailto || true

if (( first_install )); then
  mkdir -p "$state_dir/migrations"
  for migration in "$FEDORY_PATH"/migrations/*.sh; do
    [[ -f $migration ]] && touch "$state_dir/migrations/$(basename "$migration")"
  done
fi

fedory-done mark finalize-user
echo "User finalization complete."
