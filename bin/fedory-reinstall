#!/bin/bash

# fedory:summary=Reinstall Fedory packages and reset default configs
# fedory:requires-sudo=true

set -e

echo -e "This will reinstall all default Fedory packages and reset default configs.\nWarning: user config changes will be overwritten.\n"

if gum confirm "Are you sure you want to reinstall and lose config changes?"; then
  fedory-reinstall-pkgs
  fedory-reinstall-configs

  gum confirm "System has been reinstalled. Reboot?" && fedory-system-reboot
fi
