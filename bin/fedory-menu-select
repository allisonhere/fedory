#!/bin/bash

# fedory:summary=Pick one option from a menu
# fedory:group=menu
# fedory:name=select
# fedory:args=prompt [option...] [-- menu args...]
# fedory:examples=fedory menu select Format jpg png|fedory-menu-select Resolution 4k 1080p 720p -- --width 400

# An option may lead with an icon, as "<glyph><TAB><label>". The menu shows the
# glyph and returns the label alone, so callers never strip it back off.

set -euo pipefail

if (( $# < 1 )); then
  echo "Usage: fedory-menu-select <prompt> [option...] [-- menu args...]" >&2
  exit 1
fi

prompt="$1"
shift

options=()
menu_width=""
menu_maxheight=""

while (( $# > 0 )); do
  if [[ $1 == "--" ]]; then
    shift
    while (( $# > 0 )); do
      case "$1" in
        --width)
          shift
          if (( $# == 0 )); then
            echo "fedory-menu-select: --width requires a value" >&2
            exit 1
          fi
          menu_width="$1"
          ;;
        --height|--maxheight)
          arg="$1"
          shift
          if (( $# == 0 )); then
            echo "fedory-menu-select: $arg requires a value" >&2
            exit 1
          fi
          menu_maxheight="$1"
          ;;
      esac
      shift
    done
    break
  fi

  options+=("$1")
  shift
done

if (( ${#options[@]} == 0 )) && [[ ! -t 0 ]]; then
  mapfile -t options
fi

if (( ${#options[@]} == 0 )); then
  echo "Usage: fedory-menu-select <prompt> [option...] [-- menu args...]" >&2
  exit 1
fi

selection_file=$(mktemp)
done_file=$(mktemp)
rm -f "$done_file"
trap 'rm -f "$selection_file" "$done_file"' EXIT

options_json=$(jq -cn --args '$ARGS.positional' "${options[@]}")
payload=$(jq -cn \
  --arg mode "select" \
  --arg prompt "$prompt" \
  --argjson options "$options_json" \
  --arg selectionFile "$selection_file" \
  --arg doneFile "$done_file" \
  --arg width "$menu_width" \
  --arg maxHeight "$menu_maxheight" \
  '{
    mode: $mode,
    prompt: $prompt,
    options: $options,
    selectionFile: $selectionFile,
    doneFile: $doneFile
  }
  + (if $width == "" then {} else {width: ($width | tonumber)} end)
  + (if $maxHeight == "" then {} else {maxHeight: ($maxHeight | tonumber)} end)')

fedory-shell shell summon fedory.menu "$payload" >/dev/null

while [[ ! -e $done_file ]]; do
  sleep 0.05
done

if [[ -s $selection_file ]]; then
  cat "$selection_file"
else
  exit 1
fi
