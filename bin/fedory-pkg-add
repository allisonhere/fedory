#!/bin/bash

# fedory:summary=Install packages if they are missing (dnf, resolving COPR/Flatpak via the package map)
# fedory:args=<packages...>
# fedory:examples=fedory pkg add jq ripgrep | fedory pkg add hyprland quickshell-git

set -uo pipefail

if [[ -f ${FEDORY_PATH:-}/install/helpers/ui.sh ]]; then
  source "$FEDORY_PATH/install/helpers/ui.sh"
else
  has_gum() { command -v gum >/dev/null 2>&1; }
  ui_info() { if has_gum; then gum style --foreground 63 -- "$*"; else echo "  $*"; fi; }
  ui_warn() { if has_gum; then gum style --foreground 214 --bold -- "Warning: $*" >&2; else echo "Warning: $*" >&2; fi; }
  ui_error() { if has_gum; then gum style --foreground 196 --bold -- "Error: $*" >&2; else echo "Error: $*" >&2; fi; }
fi

if (( $# == 0 )); then
  ui_error "Usage: fedory-pkg-add <packages...>"
  exit 1
fi

PACKAGE_MAP="${FEDORY_PATH:-}/packaging/package-map.tsv"

# lookup_map <upstream_pkg> <column 2-7 name> -> prints the field, or empty
# if the package isn't in the map (in which case callers treat the name as
# an already-correct dnf package name -- see packaging/README.md). A "-"
# cell (package-map.tsv's convention for "not applicable") also prints as
# empty: callers use `${value:-$fallback}`, which only substitutes on an
# actually-empty string -- passing through the literal dash would make
# every caller treat "-" itself as a real package/COPR/flatpak name.
lookup_map() {
  local pkg="$1" field="$2"
  [[ -f $PACKAGE_MAP ]] || return 0
  awk -F'\t' -v pkg="$pkg" -v field="$field" '
    NR == 1 { for (i = 1; i <= NF; i++) col[$i] = i; next }
    $1 == pkg { v = $(col[field]); if (v != "-") print v; found = 1; exit }
    END { if (!found) exit 1 }
  ' "$PACKAGE_MAP"
}

dnf_pkgs=()
coprs=()
declare -A copr_seen=()
declare -A pkg_needs_copr=()   # final dnf package name -> COPR required before install is even attempted (status=copr/copr-or-source)
declare -A pkg_copr_fallback=() # final dnf package name -> COPR to try only if a plain dnf install of it fails (status=dnf-or-copr)
flatpaks=()
skipped_notes=()

for requested in "$@"; do
  if [[ ! -f $PACKAGE_MAP ]]; then
    dnf_pkgs+=("$requested")
    continue
  fi

  status=$(lookup_map "$requested" status) || true

  if [[ -z $status ]]; then
    # Not in the map -- assume it's already a valid Fedora package name.
    dnf_pkgs+=("$requested")
    continue
  fi

  case "$status" in
    dnf | "dnf (RPM Fusion)")
      fedora_pkg=$(lookup_map "$requested" fedora_pkg)
      dnf_pkgs+=("${fedora_pkg:-$requested}")
      if [[ $status == "dnf (RPM Fusion)" ]]; then
        ui_warn "$requested needs RPM Fusion enabled (see packaging/README.md)"
      fi
      ;;
    dnf-or-copr)
      # Try a plain dnf install first (recent Fedora releases increasingly
      # ship these directly); only enable the fallback COPR afterward, and
      # only for this specific package, if that didn't work. See the
      # dnf-or-copr fallback pass below the main install.
      fedora_pkg=$(lookup_map "$requested" fedora_pkg)
      copr=$(lookup_map "$requested" copr)
      final_pkg="${fedora_pkg:-$requested}"
      dnf_pkgs+=("$final_pkg")
      if [[ -n $copr && $copr != "-" ]]; then
        pkg_copr_fallback[$final_pkg]="$copr"
      fi
      ;;
    copr | copr-or-source)
      copr=$(lookup_map "$requested" copr)
      fedora_pkg=$(lookup_map "$requested" fedora_pkg)
      final_pkg="${fedora_pkg:-$requested}"
      if [[ -n $copr && $copr != "-" ]]; then
        if [[ -z ${copr_seen[$copr]:-} ]]; then
          coprs+=("$copr")
          copr_seen[$copr]=1
        fi
        pkg_needs_copr[$final_pkg]="$copr"
      fi
      dnf_pkgs+=("$final_pkg")
      ;;
    flatpak)
      flatpak_id=$(lookup_map "$requested" flatpak)
      flatpaks+=("${flatpak_id:-$requested}")
      ;;
    dropped | source-build | external-repo)
      rationale=$(lookup_map "$requested" rationale)
      skipped_notes+=("$requested ($status): ${rationale:-see packaging/package-map.tsv}")
      ;;
    *)
      # Unknown status value -- fail safe by treating it as a plain dnf name
      # rather than silently dropping it.
      dnf_pkgs+=("$requested")
      ;;
  esac
done

# A COPR failing to enable (no build for this Fedora version yet is common
# right after a new release, or a transient network/mirror issue) shouldn't
# block every other package in this call -- callers like
# install/config/base-packages.sh pass in a hundred-plus packages at once,
# and one unavailable COPR used to abort the entire batch before anything
# else got installed. Track failures and drop just the packages that needed
# them instead.
declare -A copr_failed=()
enable_copr() {
  local copr="$1" progress="${2:-}"
  if [[ -n ${copr_failed[$copr]:-} ]]; then
    return 1
  fi
  ui_info "Enabling COPR${progress:+ ($progress)}: $copr"
  if sudo dnf copr enable -y "$copr"; then
    return 0
  fi
  ui_warn "could not enable COPR '$copr' -- skipping packages that need it"
  copr_failed[$copr]=1
  return 1
}

copr_index=0
for copr in "${coprs[@]}"; do
  copr_index=$((copr_index + 1))
  enable_copr "$copr" "$copr_index/${#coprs[@]}" || true
done

if (( ${#copr_failed[@]} > 0 )); then
  filtered_pkgs=()
  for pkg in "${dnf_pkgs[@]}"; do
    needed_copr="${pkg_needs_copr[$pkg]:-}"
    if [[ -n $needed_copr && -n ${copr_failed[$needed_copr]:-} ]]; then
      skipped_notes+=("$pkg: COPR '$needed_copr' unavailable (couldn't enable it -- possibly no build for this Fedora version yet)")
      continue
    fi
    filtered_pkgs+=("$pkg")
  done
  dnf_pkgs=("${filtered_pkgs[@]}")
fi

still_missing=()

if (( ${#dnf_pkgs[@]} > 0 )); then
  if fedory-pkg-missing "${dnf_pkgs[@]}"; then
    ui_info "Installing ${#dnf_pkgs[@]} package(s) via dnf (this can take a while)..."
    # --skip-unavailable/--skip-broken keep one bad package name or one real
    # conflict (e.g. a package that clashes with something already installed
    # on this particular machine) from blocking every other package in the
    # same transaction -- dnf resolves the whole batch as one unit, so
    # without these flags a single problem anywhere aborts the lot.
    if (( EUID == 0 )); then
      dnf install -y --skip-unavailable --skip-broken --setopt=install_weak_deps=False "${dnf_pkgs[@]}" || true
    else
      sudo dnf install -y --skip-unavailable --skip-broken --setopt=install_weak_deps=False "${dnf_pkgs[@]}" || true
    fi
  fi

  for pkg in "${dnf_pkgs[@]}"; do
    # Secondary check to handle states where dnf doesn't actually register an error
    if ! rpm -q "$pkg" &>/dev/null; then
      still_missing+=("$pkg")
    fi
  done
fi

# dnf-or-copr fallback: anything still missing that has a fallback COPR gets
# one more try -- enable that COPR and install just this package, rather
# than the whole batch.
if (( ${#still_missing[@]} > 0 )); then
  retry_missing=()
  for pkg in "${still_missing[@]}"; do
    fallback_copr="${pkg_copr_fallback[$pkg]:-}"
    if [[ -z $fallback_copr ]]; then
      retry_missing+=("$pkg")
      continue
    fi
    enable_copr "$fallback_copr" && sudo dnf install -y --setopt=install_weak_deps=False "$pkg"
    if ! rpm -q "$pkg" &>/dev/null; then
      retry_missing+=("$pkg")
    fi
  done
  still_missing=("${retry_missing[@]}")
fi

for pkg in "${still_missing[@]}"; do
  ui_error "Package '$pkg' did not install"
done

if (( ${#flatpaks[@]} > 0 )); then
  if ! command -v flatpak >/dev/null 2>&1; then
    ui_error "flatpak is required to install: ${flatpaks[*]}"
    exit 1
  fi
  ui_info "Installing ${#flatpaks[@]} Flatpak(s)..."
  flatpak install -y --noninteractive flathub "${flatpaks[@]}" || exit 1
fi

for note in "${skipped_notes[@]}"; do
  ui_warn "skipped $note"
done

if (( ${#still_missing[@]} > 0 )); then
  exit 1
fi

exit 0
