#!/bin/bash

# fedory:summary=Render text with the active theme's three-stop gradient
# fedory:args=[--force] [file]
# fedory:hidden=true

set -euo pipefail

force=0
input="-"

while (($#)); do
  case "$1" in
    --force)
      force=1
      ;;
    -h|--help)
      echo "Usage: fedory-branding-gradient [--force] [file]"
      exit 0
      ;;
    -)
      input="-"
      ;;
    *)
      if [[ $input != "-" ]]; then
        echo "Usage: fedory-branding-gradient [--force] [file]" >&2
        exit 1
      fi
      input=$1
      ;;
  esac
  shift
done

if [[ $input != "-" && ! -f $input ]]; then
  echo "Gradient input not found: $input" >&2
  exit 1
fi

if (( force == 0 )) && { [[ ! -t 1 ]] || [[ -n ${NO_COLOR:-} ]] || [[ ${TERM:-} == "dumb" ]]; }; then
  if [[ $input == "-" ]]; then
    cat
  else
    cat <"$input"
  fi
  exit 0
fi

theme_color() {
  local key=$1 fallback=$2 value=""
  value=$(fedory-theme-color "$key" 2>/dev/null || true)
  if [[ $value =~ ^#[0-9A-Fa-f]{6}$ ]]; then
    printf '%s\n' "$value"
  else
    printf '%s\n' "$fallback"
  fi
}

start=$(theme_color accent "#51a2da")
middle=$(theme_color magenta "#8b5cf6")
end=$(theme_color cyan "#22d3ee")

render_gradient() {
  awk -v start="${start#\#}" -v middle="${middle#\#}" -v end="${end#\#}" '
    function hex_digit(char) {
      return index("0123456789abcdef", tolower(char)) - 1
    }

    function hex_byte(color, offset) {
      return hex_digit(substr(color, offset, 1)) * 16 + hex_digit(substr(color, offset + 1, 1))
    }

    function channel(from, to, amount) {
      return int(from + (to - from) * amount + 0.5)
    }

    {
      lines[NR] = $0
      if (length($0) > width) width = length($0)
    }

    END {
      sr = hex_byte(start, 1); sg = hex_byte(start, 3); sb = hex_byte(start, 5)
      mr = hex_byte(middle, 1); mg = hex_byte(middle, 3); mb = hex_byte(middle, 5)
      er = hex_byte(end, 1); eg = hex_byte(end, 3); eb = hex_byte(end, 5)

      for (row = 1; row <= NR; row++) {
        for (column = 1; column <= length(lines[row]); column++) {
          char = substr(lines[row], column, 1)
          if (char == " ") {
            printf "%s", char
            continue
          }

          amount = width > 1 ? (column - 1) / (width - 1) : 0
          if (NR > 1) amount += (0.5 - (row - 1) / (NR - 1)) * 0.16
          if (amount < 0) amount = 0
          if (amount > 1) amount = 1
          if (amount <= 0.5) {
            mix = amount * 2
            r = channel(sr, mr, mix); g = channel(sg, mg, mix); b = channel(sb, mb, mix)
          } else {
            mix = (amount - 0.5) * 2
            r = channel(mr, er, mix); g = channel(mg, eg, mix); b = channel(mb, eb, mix)
          }
          printf "\033[1;38;2;%d;%d;%dm%s", r, g, b, char
        }
        printf "\033[0m\n"
      }
    }
  '
}

if [[ $input == "-" ]]; then
  render_gradient
else
  render_gradient <"$input"
fi
