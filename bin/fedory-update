#!/bin/bash

# fedory:summary=Update Fedory and system packages
# fedory:args=[-y]
# fedory:examples=fedory update | fedory update -y
# fedory:requires-sudo=true
#
# Fedora-native rewrite: same orchestration shape as upstream, with dnf/rpm
# equivalents swapped in throughout (see each fedory-update-* script for its
# own rewrite notes). Drops omarchy-update-aur-pkgs entirely: dnf has no
# separate package class the way AUR is separate from pacman's official
# repos -- COPR-installed packages are ordinary dnf packages once installed,
# so `dnf upgrade` above already covers them in one pass. Also drops the
# pacman-guard step upstream runs implicitly via an ALPM hook (redirecting
# raw `pacman -Syu` back to `omarchy update`) -- dnf has no hook mechanism
# to build an equivalent on; see docs/scope.md.

set -e

update_log="${FEDORY_UPDATE_LOG_FILE:-/tmp/fedory-update.log}"

if [[ -z ${FEDORY_UPDATE_LOGGED:-} ]]; then
  script_command=$(printf '%q ' "$0" "$@")
  if fedory-cmd-present script; then
    exec env FEDORY_UPDATE_LOGGED=1 script -qefc "$script_command" "$update_log"
  fi

  # Fedora splits `script` into util-linux-script, which older Fedory
  # installations did not include. Keep their first repair update usable and
  # retain a plain-text log; the normal DNF pass installs the missing package.
  FEDORY_UPDATE_LOGGED=1 "$0" "$@" 2>&1 | tee "$update_log"
  update_status=${PIPESTATUS[0]}
  exit "$update_status"
fi

if ! fedory-update-lock held; then
  exec fedory-update-lock run "$0" "$@"
fi

trap 'echo ""; echo -e "\033[0;31mSomething went wrong during the update!\n\nPlease review the output above carefully, correct the error, and retry the update.\n\nIf you need assistance, open an issue at https://github.com/${FEDORY_REPO:-allisonhere/fedory}/issues\033[0m"' ERR
trap 'fedory-update-stay-awake stop' EXIT

fedory-update-requires-free-space

if [[ ${1:-} == "-y" ]] || fedory-update-confirm; then
  fedory-snapshot create || (($? == 127))

  fedory-update-stay-awake start

  fedory-update-dev
  fedory-update-keyring
  fedory-update-system-pkgs
  fedory-migrate
  fedory-hook post-update
  fedory-update-mise
  fedory-update-orphan-pkgs

  fedory-update-analyze-logs
  fedory-update-status

  # Release update-owned inhibitors before offering a reboot. A confirmed
  # reboot can terminate this process before its EXIT trap gets a chance to
  # remove the persistent Stay Awake marker.
  fedory-update-stay-awake stop
  trap - EXIT

  fedory-update-restart
fi
