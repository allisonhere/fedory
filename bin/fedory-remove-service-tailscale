#!/bin/bash

# fedory:summary=Remove Tailscale and its bar plugin.
# fedory:requires-sudo=true

tailscale down 2>/dev/null || true
systemctl --user disable --now fedory-tailscale-receive.service 2>/dev/null || true
sudo systemctl disable --now tailscaled.service 2>/dev/null || true
fedory-plugin-disable fedory.tailscale
fedory-webapp-remove "Tailscale" 2>/dev/null || true
fedory-pkg-drop tailscale

echo ""
echo "Tailscale has been removed."
