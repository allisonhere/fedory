#!/bin/bash

# fedory:summary=Set the default editor used by fedory-launch-editor
# fedory:args=[code|cursor|zed|sublime_text|helix|vim|emacs|nvim]
# fedory:examples=fedory default editor | fedory default editor code | fedory default editor helix

editor_file="$HOME/.local/state/fedory/defaults/editor"

if (($# == 0)); then
  if [[ -f $editor_file ]]; then
    read -r editor <"$editor_file"
  fi

  [[ -n $editor ]] && echo "$editor" || echo "nvim"
  exit 0
fi

case "$1" in
code) editor="code"; name="VSCode"; glyph= ;;
cursor) editor="cursor"; name="Cursor"; glyph= ;;
zed | zeditor) editor="zeditor"; name="Zed"; glyph= ;;
sublime_text) editor="sublime_text"; name="Sublime Text"; glyph= ;;
helix) editor="helix"; name="Helix"; glyph= ;;
vim) editor="vim"; name="Vim"; glyph= ;;
emacs) editor="emacs"; name="Emacs"; glyph= ;;
nvim) editor="nvim"; name="Neovim"; glyph= ;;
*)
  echo "Usage: fedory-default-editor <code|cursor|zed|sublime_text|helix|vim|emacs|nvim>"
  exit 1
  ;;
esac

mkdir -p "$(dirname "$editor_file")"
printf '%s\n' "$editor" >"$editor_file"

fedory-notification-send -g $glyph "$name is now the default editor"
