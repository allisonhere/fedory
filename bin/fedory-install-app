#!/bin/bash

# fedory:summary=Install a packaged app, surfacing the install in a floating terminal
# fedory:args=<display-name> <packages>
# fedory:examples=fedory install app 'LM Studio' lmstudio-bin

name="${1-}"
packages="${2-}"

if [[ -z $name || -z $packages ]]; then
  echo "Usage: fedory-install-app <display-name> <packages>" >&2
  exit 1
fi

exec fedory-launch-floating-terminal-with-presentation "echo 'Installing ${name}...'; fedory-pkg-add ${packages}"
