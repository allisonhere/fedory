#!/bin/bash

# fedory:summary=Finish first-login setup for Fedory.
# fedory:args=[--force]

set -e

usage() {
  cat <<USAGE
Usage: fedory-first-run [--force]

Run first-login user setup and notification hooks. By default this only runs
once per user. Use --force to rerun the full sequence and refresh user setup.
USAGE
}

force=0
finalize_user_args=()
while (($#)); do
  case "$1" in
    --force)
      force=1
      finalize_user_args+=(--force)
      shift
      ;;
    -h|--help)
      usage
      exit 0
      ;;
    *)
      echo "Unknown option: $1" >&2
      usage >&2
      exit 1
      ;;
  esac
done

state_dir=~/.local/state/fedory
FIRST_RUN_DONE="first-run-user"
if fedory-done check "$FIRST_RUN_DONE" && (( force == 0 )); then
  echo "First-run already complete (rerun with --force to refresh)."
  exit 0
fi

fedory-finalize-user "${finalize_user_args[@]}" || true

mkdir -p "$state_dir"

FIRST_RUN_LOG="$state_dir/first-run.log"
first_run_failed=0

log_first_run() {
  printf '[%s] %s\n' "$(date '+%Y-%m-%d %H:%M:%S')" "$*" >>"$FIRST_RUN_LOG"
}

run_first_run_step() {
  local name="$1"
  shift

  log_first_run "Starting: $name"
  if "$@"; then
    log_first_run "Completed: $name"
  else
    local status=$?
    first_run_failed=1
    log_first_run "Failed: $name (exit code: $status)"
  fi
}

run_first_run_step "install Voxtype post-update hook" \
  fedory-hook-install post-update "$FEDORY_PATH/install/user/first-run/install-voxtype.hook"
run_first_run_step "install fingerprint setup post-update hook" \
  fedory-hook-install post-update "$FEDORY_PATH/install/user/first-run/setup-fingerprint.hook"

run_first_run_step "enable user systemd units" \
  bash "$FEDORY_PATH/install/user/first-run/enable-user-units.sh"
run_first_run_step "set GNOME theme" \
  bash "$FEDORY_PATH/install/user/first-run/gnome-theme.sh"
run_first_run_step "set GTK primary paste" \
  bash "$FEDORY_PATH/install/user/first-run/gtk-primary-paste.sh"
run_first_run_step "apply speaker tuning" \
  bash "$FEDORY_PATH/install/user/first-run/audio-tuning.sh"

fedory-notification-wait || log_first_run "Timed out waiting for notification service; continuing"
run_first_run_step "show welcome notification" \
  bash "$FEDORY_PATH/install/user/first-run/welcome.sh"
# The first-run notification scripts register action callbacks in background
# notify-send processes. Give the notification server a tick to ingest the
# welcome toast before queueing the Wi-Fi/update toasts.
sleep 0.3
run_first_run_step "show Wi-Fi/update notifications" \
  bash "$FEDORY_PATH/install/user/first-run/wifi.sh"

if (( first_run_failed == 0 )); then
  fedory-done mark "$FIRST_RUN_DONE"
else
  log_first_run "One or more first-run steps failed; first-run will retry next login"
fi
