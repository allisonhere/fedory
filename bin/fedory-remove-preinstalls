#!/bin/bash

# fedory:summary=Remove preinstalled Fedory applications (web apps, TUIs, and selected packages).
#
# Fedora-native rewrite: several of upstream's dropped packages are Flatpak
# apps under this port (spotify, signal-desktop -- see
# fedory-install-service-spotify/-signal), not dnf packages, so
# fedory-pkg-drop alone would silently no-op on them. Split into a dnf-drop
# list and a flatpak-uninstall list instead. aether/cliamp (first-party
# Basecamp tools with no confirmed Fedora build -- see
# packaging/package-map.tsv) are left out since they were never
# installable here in the first place.

if gum confirm "Are you sure you want to remove all preinstalled web apps, TUI wrappers, and desktop applications?"; then
  echo -e "Removing preinstalled Fedory applications...\n"

  fedory-webapp-remove-all
  fedory-tui-remove-all

  mkdir -p ~/.local/state/fedory
  touch ~/.local/state/fedory/preinstalls-removed
  hyprctl reload

  # Remove mise stubs
  rm -f ~/.local/bin/codex ~/.local/bin/claude ~/.local/bin/gemini ~/.local/bin/copilot \
       ~/.local/bin/gh ~/.local/bin/opencode ~/.local/bin/playwright ~/.local/bin/playwright-cli ~/.local/bin/pi \
       ~/.local/bin/ghui ~/.local/bin/hunk

  fedory-pkg-drop \
    typora \
    libreoffice-fresh \
    1password \
    1password-cli \
    xournalpp \
    pinta \
    obs-studio \
    kdenlive \
    lazydocker \
    opencode \
    claude-code \
    github-cli

  if command -v flatpak >/dev/null 2>&1; then
    flatpak uninstall -y com.spotify.Client org.signal.Signal md.obsidian.Obsidian 2>/dev/null || true
  fi
fi
