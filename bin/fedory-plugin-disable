#!/bin/bash

# fedory:summary=Disable a shell plugin
# fedory:group=plugin
# fedory:args=<id>

set -euo pipefail

fail() {
  echo "fedory-plugin-disable: $*" >&2
  exit 1
}

if [[ ${1:-} == "-h" || ${1:-} == "--help" ]]; then
  echo "Usage: fedory plugin disable <id>"
  exit 0
fi

id="${1:-}"
[[ -n $id ]] || fail "plugin id is required"

result=$(fedory-shell shell setPluginEnabled "$id" false)
[[ $result == "ok" ]] ||
  fail "plugin '$id' is not known; run: fedory-shell shell rescanPlugins"

echo "Disabled $id"
