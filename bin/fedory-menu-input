#!/bin/bash

# fedory:summary=Prompt for text input from a menu
# fedory:group=menu
# fedory:name=input
# fedory:args=prompt [menu args...]
# fedory:examples=fedory menu input Reminder|fedory-menu-input "Reminder in minutes" --width 400

set -euo pipefail

prompt="${1:-Input}"
if (( $# > 0 )); then
  shift
fi

menu_width=""

while (( $# > 0 )); do
  case "$1" in
    --width)
      shift
      if (( $# == 0 )); then
        echo "fedory-menu-input: --width requires a value" >&2
        exit 1
      fi
      menu_width="$1"
      ;;
  esac
  shift
done

selection_file=$(mktemp)
done_file=$(mktemp)
rm -f "$done_file"
trap 'rm -f "$selection_file" "$done_file"' EXIT

payload=$(jq -cn \
  --arg mode "input" \
  --arg prompt "$prompt" \
  --arg selectionFile "$selection_file" \
  --arg doneFile "$done_file" \
  --arg width "$menu_width" \
  '{
    mode: $mode,
    prompt: $prompt,
    selectionFile: $selectionFile,
    doneFile: $doneFile
  }
  + (if $width == "" then {} else {width: ($width | tonumber)} end)')

fedory-shell shell summon fedory.menu "$payload" >/dev/null

while [[ ! -e $done_file ]]; do
  sleep 0.05
done

if [[ -s $selection_file ]]; then
  cat "$selection_file"
else
  exit 1
fi
