#!/bin/bash

# fedory:summary=Show or hide the tablet on-screen keyboard

if systemctl --user is-active --quiet fedory-tablet-keyboard.service; then
  systemctl --user stop fedory-tablet-keyboard.service
  fedory-osd -i keyboard -m "On-screen keyboard hidden"
else
  systemctl --user start fedory-tablet-keyboard.service
  fedory-osd -i keyboard -m "On-screen keyboard ready"
fi
