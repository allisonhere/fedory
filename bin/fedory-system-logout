#!/bin/bash

# fedory:summary=Log out after closing application windows
# fedory:examples=fedory logout | fedory system logout
# fedory:aliases=fedory logout

nohup bash -c "sleep 2 && uwsm stop" >/dev/null 2>&1 &

fedory-osd -i logout -m "Logging out" -d 5000

# Now close all windows
fedory-hyprland-window-close-all
sleep 1 # Allow apps like Chrome to shutdown correctly
