#!/bin/bash

# fedory:summary=Install Lutris with Wine for running Windows games (Battle.net, EA, Ubisoft Connect, etc.)
# fedory:requires-sudo=true
#
# Fedora-native rewrite: `lutris` and `wine` are both in Fedora's official
# repos (unlike Arch, where wine-staging/wine-mono/wine-gecko are AUR/
# multilib extras) -- winehq.org also publishes an official Fedora repo for
# the newest Wine builds if the stock package proves too old, but this
# starts with the simpler stock-repo path. umu-launcher has no confirmed
# Fedora RPM; see packaging/package-map.tsv.

set -e

echo "Installing Lutris..."
fedory-pkg-add lutris wine winetricks

# Lutris ships with `#!/usr/bin/env python3`, which resolves to mise's Python and
# fails to import the lutris module. Pin the shebang to the system Python.
if [[ -f /usr/bin/lutris ]]; then
  sudo sed -i '/env python3/ c\#!/bin/python3' /usr/bin/lutris
fi

cat <<'EOF'

Lutris will open and auto-fetch its DXVK and VKD3D runtimes in the background
(watch the bottom status bar). Once that finishes, click the + to add or install games.

EOF

setsid lutris >/dev/null 2>&1 &
