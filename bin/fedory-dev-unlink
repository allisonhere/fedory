#!/bin/bash

# fedory:summary=Restore Fedory to the package install after reboot
# fedory:group=dev
# fedory:args=[--no-reboot]

set -euo pipefail

if (( EUID == 0 )); then
  echo "Error: run fedory-dev-unlink as your user, not under sudo." >&2
  exit 1
fi

prompt_reboot=1

if (( $# > 1 )); then
  echo "Usage: fedory dev unlink [--no-reboot]" >&2
  exit 1
fi

case "${1:-}" in
  "")
    ;;
  --no-reboot)
    prompt_reboot=0
    ;;
  -h|--help)
    cat <<USAGE
Usage: fedory dev unlink [--no-reboot]

Writes /etc/fedory.conf so FEDORY_PATH resolves to /usr/share/fedory
after reboot. This intentionally does not rewrite the running Hyprland,
systemd, shell, or app-launcher environment; reboot to make every layer agree.

Use --no-reboot when another command will handle the reboot prompt.
USAGE
    exit 0
    ;;
  *)
    echo "Usage: fedory dev unlink [--no-reboot]" >&2
    exit 1
    ;;
esac

default_target="/usr/share/fedory"

printf 'export FEDORY_PATH="%s"\n' "$default_target" | sudo tee /etc/fedory.conf >/dev/null

echo "Pointed Fedory at $default_target"
echo

if (( prompt_reboot )) && gum confirm "Reboot now to activate?"; then
  fedory-system-reboot
fi
