#!/bin/bash

# fedory:summary=Launch Signal or start its installer when missing.

set -e

WINDOW_ADDRESS=$(hyprctl clients -j | jq -r '.[]|select((.class|test("\\bsignal\\b";"i")) or (.title|test("\\bsignal\\b";"i")))|.address' | head -n1)

if [[ -n $WINDOW_ADDRESS ]]; then
  hyprctl dispatch "hl.dsp.focus({ window = \"address:$WINDOW_ADDRESS\" })" >/dev/null 2>&1 || hyprctl dispatch focuswindow "address:$WINDOW_ADDRESS"
elif flatpak info org.signal.Signal >/dev/null 2>&1; then
  # Signal ships via Flathub on Fedora (see fedory-install-service-signal),
  # not a native /usr/bin/signal-desktop binary.
  exec setsid flatpak run org.signal.Signal
else
  exec fedory-launch-floating-terminal-with-presentation fedory-install-service-signal
fi
