#!/bin/bash

# fedory:summary=Update the active Fedory dev checkout

set -euo pipefail

[[ $FEDORY_PATH != "/usr/share/fedory" ]] || exit 0

if ! git -C "$FEDORY_PATH" rev-parse --is-inside-work-tree >/dev/null 2>&1; then
  echo "Error: FEDORY_PATH is not a git checkout: $FEDORY_PATH" >&2
  exit 1
fi

upstream=$(git -C "$FEDORY_PATH" rev-parse --abbrev-ref --symbolic-full-name '@{upstream}' 2>/dev/null || true)
if [[ -z $upstream ]]; then
  echo -e "\e[33m\nSkip Fedory dev checkout update (current branch has no upstream)\e[0m"
  exit 0
fi

echo -e "\e[32m\nUpdate Fedory dev checkout\e[0m"
git -C "$FEDORY_PATH" pull --ff-only
