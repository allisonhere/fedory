#!/bin/bash

# fedory:summary=Select and set the system timezone
# fedory:group=menu
# fedory:name=timezone

set -e

timezone=$(timedatectl list-timezones | fedory-menu-select "Set timezone" -- --width 520 --maxheight 520) || exit 1
sudo timedatectl set-timezone "$timezone"
fedory-shell -q fedory.clock refresh
fedory-notification-send "Timezone is now set to $timezone"
