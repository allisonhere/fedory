#!/bin/bash

# fedory:summary=Install RetroArch and set up a ~/Games ROM directory.
#
# Fedora-native rewrite: upstream installs ~40 individually-named
# libretro-*-git AUR/Arch packages for an exhaustive core set. RPM
# Fusion packages RetroArch and a real but smaller set of libretro-*
# cores than Arch's AUR does, and exactly which cores RPM Fusion ships
# under which package names hasn't been verified here -- rather than
# guess at ~40 RPM names and risk half of them silently failing to
# install, this installs base RetroArch only. Additional cores can be
# added to packaging/package-map.tsv once confirmed; RetroArch's own
# built-in core downloader (Main Menu > Online Updater > Core Downloader)
# also works entirely independently of the system package manager.

set -e

echo "Installing RetroArch..."
fedory-pkg-add retroarch

# Set up ~/Games for BIOS files and ROMs
mkdir -p "$HOME/Games/bios" "$HOME/Games/roms"

CFG="$HOME/.config/retroarch/retroarch.cfg"
mkdir -p "$(dirname "$CFG")"
touch "$CFG"

set_cfg() {
  local key=$1 value=$2
  if grep -q "^$key = " "$CFG"; then
    sed -i "s|^$key = .*|$key = \"$value\"|" "$CFG"
  else
    echo "$key = \"$value\"" >>"$CFG"
  fi
}

set_cfg rgui_browser_directory "$HOME/Games/roms"
set_cfg system_directory "$HOME/Games/bios"

# Vulkan is required for slang shaders and unlocks hardware renderers in beetle-psx-hw, parallel-n64, dolphin
set_cfg video_driver "vulkan"

# XMB is the classic PS3-style menu (vs. ozone/rgui/glui)
set_cfg menu_driver "xmb"

# Hide Images and Video tabs in the main menu sidebar
set_cfg content_show_images "false"
set_cfg content_show_video "false"

echo ""
echo "Put your roms and bios files in ~/Games. RetroArch's own Core Downloader"
echo "(Main Menu > Online Updater > Core Downloader) is the most reliable way"
echo "to install cores on Fedora -- start RetroArch from the app launcher"
echo "(Super + Space) and use that instead of hunting for RPM core packages."

setsid nautilus "$HOME/Games" >/dev/null 2>&1 &
