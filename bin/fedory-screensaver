#!/bin/bash

# fedory:summary=Run the Fedory screensaver using random effects from TTE.

branding="$HOME/.config/fedory/branding/screensaver.txt"
if [[ ! -s $branding ]]; then
  mkdir -p "$(dirname "$branding")"
  cp "$FEDORY_PATH/logo.txt" "$branding" 2>/dev/null || true
fi

if [[ ! -s $branding ]]; then
  echo "Screensaver branding is missing: $branding" >&2
  exit 1
fi

colored_branding=$(mktemp)
fedory-branding-gradient --force "$branding" >"$colored_branding"

screensaver_in_focus() {
  hyprctl activewindow -j | jq -e '.class == "org.fedory.screensaver"' >/dev/null 2>&1
}

exit_screensaver() {
  hyprctl eval 'hl.config({ cursor = { invisible = false } })' &>/dev/null || hyprctl keyword cursor:invisible false &>/dev/null || true
  pkill -x tte 2>/dev/null
  pkill -f '[o]rg.fedory.screensaver' 2>/dev/null
  rm -f "$colored_branding"
  exit 0
}

# Exit the screensaver on signals and input from keyboard and mouse
trap exit_screensaver SIGINT SIGTERM SIGHUP SIGQUIT

printf '\033]11;rgb:00/00/00\007'  # Set background color to black

hyprctl eval 'hl.config({ cursor = { invisible = true } })' &>/dev/null || hyprctl keyword cursor:invisible true &>/dev/null

tty=$(tty 2>/dev/null)

while true; do
  tte -i "$colored_branding" --existing-color-handling always \
    --frame-rate 120 --canvas-width 0 --canvas-height 0 --reuse-canvas --anchor-canvas c --anchor-text c\
    --random-effect --no-eol --no-restore-cursor &

  while pgrep -t "${tty#/dev/}" -x tte >/dev/null; do
    if read -n1 -t 1 || ! screensaver_in_focus; then
      exit_screensaver
    fi
  done
done
