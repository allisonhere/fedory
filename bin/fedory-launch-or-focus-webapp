#!/bin/bash

# fedory:summary=Launch or focus on a given web app identified by the window-pattern.
# fedory:args=<window-pattern> <url-and-flags...>

if (($# == 0)); then
  echo "Usage: fedory-launch-or-focus-webapp [window-pattern] [url-and-flags...]"
  exit 1
fi

WINDOW_PATTERN="$1"
shift
LAUNCH_COMMAND="fedory-launch-webapp $@"

exec fedory-launch-or-focus "$WINDOW_PATTERN" "$LAUNCH_COMMAND"
