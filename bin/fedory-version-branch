#!/bin/bash

# fedory:summary=Print the active Fedory dev-link git branch
# fedory:hidden=true

fedory_path=${FEDORY_PATH:-/usr/share/fedory}
fedory_path=${fedory_path%/}

[[ $fedory_path != "/usr/share/fedory" ]] || exit 1

branch=$(git -C "$fedory_path" branch --show-current 2>/dev/null || true)
if [[ -z $branch ]]; then
  hash=$(git -C "$fedory_path" rev-parse --short HEAD 2>/dev/null || true)
  [[ -n $hash ]] || exit 1
  branch="detached@$hash"
fi

echo "$branch"
