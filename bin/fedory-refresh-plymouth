#!/bin/bash

# fedory:summary=Overwrite the user config for the Plymouth boot sequence with the Fedory default and rebuild it.
# fedory:requires-sudo=true
#
# Fedora-native rewrite: upstream rebuilds the initramfs via
# limine-mkinitcpio (falling back to mkinitcpio); dracut is Fedora's
# initramfs builder, and there's no encrypted-drive-decryption step to
# theme separately here since Fedora's default LUKS unlock prompt is
# handled by Plymouth itself, same theme.

#
# The deployment itself is shared with install/config/plymouth.sh so the
# bootstrap path and this manual refresh can't drift apart -- previously only
# this script knew how to install the theme, and nothing in the installer ever
# called it.

set -e

source "${FEDORY_PATH:-$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)}/install/helpers/plymouth.sh"

fedory_apply_plymouth_theme
