#!/bin/bash

# fedory:summary=Edit, set, or reset screensaver branding
# fedory:group=branding
# fedory:name=screensaver
# fedory:args=<image|text|reset>
# fedory:examples=fedory branding screensaver image | fedory branding screensaver text | fedory branding screensaver reset

set -euo pipefail

SOURCE_DIR="${XDG_PICTURES_DIR:-$HOME/Pictures}"

case "${1:-}" in
image)
  image=$(fedory-menu-file "Pick png/svg from $SOURCE_DIR" "${SOURCE_DIR}" "svg png")
  if [[ -n $image ]] && fedory-transcode-ascii "$image" ~/.config/fedory/branding/screensaver.txt; then
    fedory-launch-screensaver force >/dev/null 2>&1
  fi
  ;;
text)
  fedory-launch-editor ~/.config/fedory/branding/screensaver.txt >/dev/null 2>&1 && fedory-launch-screensaver force >/dev/null 2>&1
  ;;
reset)
  cp "$FEDORY_PATH/logo.txt" ~/.config/fedory/branding/screensaver.txt && fedory-launch-screensaver force >/dev/null 2>&1
  ;;
*)
  echo "Usage: fedory-branding-screensaver <image|text|reset>" >&2
  exit 1
  ;;
esac
