# Based on basecamp/omarchy default/bash/env-bootstrap.
# Single source of truth for FEDORY_PATH + PATH adjustments. Sourced by:
#   /etc/profile.d/fedory.sh                 (system login shells)
#   /etc/skel/.bashrc                         (interactive shells)
#   /usr/share/uwsm/env.d/10-fedory          (Hyprland session via uwsm)
#   /usr/share/fedory/default/bash/envs      (bash rc chain; SSH/non-login)

# /etc/fedory.conf is written by fedory-dev-link and reset by
# fedory-dev-unlink. When absent, force the packaged default instead of
# preserving a stale inherited value. Fedory's bootstrap writes this file for
# its source checkout, while a future packaged install can use the fallback.
if [ -f /etc/fedory.conf ]; then
  . /etc/fedory.conf
  : "${FEDORY_PATH:=/usr/share/fedory}"
else
  FEDORY_PATH=/usr/share/fedory
fi
export FEDORY_PATH

# Only prepend in dev-link mode. On a production install, the binaries are
# already on PATH as /usr/bin/fedory-* via the fedory package — prepending
# /usr/share/fedory/bin would just be noise.
if [ "$FEDORY_PATH" != /usr/share/fedory ]; then
  case ":$PATH:" in
    *":${FEDORY_PATH%/}/bin:"*) ;;
    *) PATH="${FEDORY_PATH%/}/bin${PATH:+:$PATH}" ;;
  esac
  export PATH
fi
