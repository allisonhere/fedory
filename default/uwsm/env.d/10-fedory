# Changes require a restart to take effect.

# Based on basecamp/omarchy default/uwsm/env.d/10-omarchy. Fedory's source
# install writes its checkout path to /etc/fedory.conf instead of installing a
# package-owned tree under /usr/share.
[ -r /etc/fedory.conf ] && . /etc/fedory.conf
[ -n "${FEDORY_PATH:-}" ] && [ -r "${FEDORY_PATH%/}/default/bash/env-bootstrap" ] \
  && . "${FEDORY_PATH%/}/default/bash/env-bootstrap"

# Fedory session defaults. Users can override these in ~/.config/uwsm/default
# or, preferably, ~/.config/uwsm/env.d/*.
if [ -f "${FEDORY_PATH%/}/default/uwsm/default" ]; then
  . "${FEDORY_PATH%/}/default/uwsm/default"
else
  export TERMINAL=xdg-terminal-exec
  export BROWSER=fedory-launch-browser
  export EDITOR="fedory-launch-editor --inline"
fi

# Optional user overrides kept for compatibility with older installs.
[ -f "$HOME/.config/uwsm/default" ] && . "$HOME/.config/uwsm/default"

# Activate mise if present on the system
fedory-cmd-present mise && eval "$(mise activate bash --shims)"
