// Based on basecamp/omarchy default/omarchy/omarchy-menu.jsonc with Fedory routes.
{
  // Fedory menu definition.
  // JSONC is used for Neovim-friendly highlighting, comments, and trailing commas.
  // IDs are object keys. Dotted IDs imply hierarchy: trigger.share.file belongs
  // under trigger.share.
  // Kind is inferred: action -> action, target -> link, otherwise submenu.
  // Dotted IDs define the tree. Use provider:"name" only when the submenu
  // calls provider_name() or a command named "name" to return JSON rows.
  // Optional fields:
  //   aliases        alternate `fedory menu summon <name>` routes; also searchable
  //   iconFont       font family used for the icon glyph, when it differs from the menu font
  //   title          header text shown when the submenu is open; defaults to label
  //   when           shell condition; hide row when it fails
  //   checked        shell condition; append ✓ when it succeeds

  // Root Menu
  "apps": {"icon":"󰀻","label":"Apps","aliases":["app","applications"],"provider":"apps"},
  "learn": {"icon":"󰧑","label":"Learn"},
  "trigger": {"icon":"󱓞","label":"Trigger"},
  "style": {"icon":"","label":"Style"},
  "setup": {"icon":"","label":"Setup","aliases":["settings"]},
  "install": {"icon":"󰉉","label":"Install"},
  "remove": {"icon":"󰭌","label":"Remove","aliases":["uninstall"]},
  "update": {"icon":"","label":"Update","aliases":["restart","refresh"]},
  "about": {"icon":"","label":"About","action":"fedory-launch-about"},
  "system": {"icon":"","label":"System","aliases":["power-menu"]},

  // System
  "system.screensaver": {"icon":"󱄄","label":"Screensaver","action":"fedory-launch-screensaver force"},
  "system.lock": {"icon":"","label":"Lock","action":"fedory-system-lock"},
  "system.suspend": {"icon":"󰒲","label":"Suspend","when":"! fedory-toggle-enabled suspend-off","action":"systemctl suspend"},
  "system.hibernate": {"icon":"󰤁","label":"Hibernate","when":"fedory-hibernation-available","action":"systemctl hibernate"},
  "system.logout": {"icon":"󰍃","label":"Logout","action":"fedory-system-logout"},
  "system.reboot": {"icon":"󰜉","label":"Reboot","action":"fedory-system-reboot"},
  "system.shutdown": {"icon":"󰐥","label":"Shutdown","action":"fedory-system-shutdown"},

  // Learn
  "learn.keybindings": {"icon":"","label":"Keybindings","action":"fedory-menu-keybindings"},
  "learn.fedory": {"icon":"","label":"Fedory","action":"fedory-launch-webapp 'https://github.com/allisonhere/fedory'"},
  "learn.hyprland": {"icon":"","label":"Hyprland","action":"fedory-launch-webapp 'https://wiki.hypr.land/'"},
  "learn.fedora": {"icon":"󰣇","label":"Fedora","action":"fedory-launch-webapp 'https://docs.fedoraproject.org/'"},
  "learn.neovim": {"icon":"","label":"Neovim","action":"fedory-launch-webapp 'https://www.lazyvim.org/keymaps'"},
  "learn.bash": {"icon":"󱆃","label":"Bash","action":"fedory-launch-webapp 'https://devhints.io/bash'"},
  "learn.tmux-keybindings": {"icon":"","label":"Tmux","action":"fedory-menu-tmux-keybindings"},

  // Trigger
  "trigger.emoji": {"icon":"","label":"Emoji","aliases":["emoji","emojis"],"action":"fedory-menu-emoji"},
  "trigger.reminder": {"icon":"󰢌","label":"Reminder","aliases":["reminder"]},
  "trigger.capture": {"icon":"","label":"Capture","aliases":["capture","screenshot","screenrecord","screen-record","screenrecording"]},
  "trigger.capture.screenshot": {"icon":"","label":"Screenshot","action":"fedory-capture-screenshot"},
  "trigger.capture.screenrecord.stop": {"icon":"","label":"Stop Screenrecording","when":"pgrep -f '^gpu-screen-recorder'","action":"fedory-capture-screenrecording --stop-recording"},
  "trigger.capture.screenrecord": {"icon":"","label":"Screenrecord"},
  "trigger.capture.text": {"icon":"󰴑","label":"Text","action":"fedory-capture-text"},
  "trigger.capture.color": {"icon":"󰃉","label":"Color","action":"pkill hyprpicker || hyprpicker -a"},
  "trigger.capture.screenrecord.no-audio": {"icon":"","label":"With no audio","action":"fedory-capture-screenrecording"},
  "trigger.capture.screenrecord.desktop-audio": {"icon":"","label":"With desktop audio","action":"fedory-capture-screenrecording --with-desktop-audio"},
  "trigger.capture.screenrecord.microphone": {"icon":"","label":"With desktop + microphone audio","action":"fedory-capture-screenrecording --with-desktop-audio --with-microphone-audio"},
  "trigger.capture.screenrecord.webcam": {"icon":"","label":"With desktop + microphone audio + webcam","when":"fedory-hw-webcam","action":"fedory-capture-screenrecording-with-webcam"},
  "trigger.transcode": {"icon":"󰧸","label":"Transcode","action":"fedory-transcode"},
  "trigger.share": {"icon":"","label":"Share","aliases":["share"]},
  "trigger.toggle": {"icon":"󰔎","label":"Toggle","aliases":["toggle","toggles"]},
  "trigger.hardware": {"icon":"","label":"Hardware","aliases":["hardware","hw"]},
  "trigger.hardware.laptop-display": {"icon":"󰛧","label":"Laptop Display","when":"fedory-hw-laptop","action":"fedory-hyprland-monitor-internal toggle"},
  "trigger.hardware.mirror-display": {"icon":"󰍹","label":"Mirror Display","when":"fedory-hw-laptop","action":"fedory-hyprland-monitor-internal-mirror toggle"},
  "trigger.hardware.hybrid-gpu": {"icon":"","label":"Hybrid GPU","when":"fedory-hw-hybrid-gpu","action":"fedory-launch-floating-terminal-with-presentation fedory-toggle-hybrid-gpu"},
  "trigger.hardware.touchpad": {"icon":"󰟸","label":"Touchpad","when":"fedory-hw-touchpad","action":"fedory-toggle-touchpad"},
  "trigger.hardware.touchpad-haptics": {"icon":"󰌌","label":"Touchpad Haptics"},
  "trigger.hardware.touchpad-haptics.low": {"icon":"󰌌","label":"low","when":"fedory-hw-dell-xps-haptic-touchpad && fedory-cmd-present dell-xps-touchpad-haptics","checked":"[[ \"$(dell-xps-touchpad-haptics get)\" == \"low\" ]]","action":"dell-xps-touchpad-haptics set low"},
  "trigger.hardware.touchpad-haptics.mid": {"icon":"󰌌","label":"mid","when":"fedory-hw-dell-xps-haptic-touchpad && fedory-cmd-present dell-xps-touchpad-haptics","checked":"[[ \"$(dell-xps-touchpad-haptics get)\" == \"mid\" ]]","action":"dell-xps-touchpad-haptics set mid"},
  "trigger.hardware.touchpad-haptics.high": {"icon":"󰌌","label":"high","when":"fedory-hw-dell-xps-haptic-touchpad && fedory-cmd-present dell-xps-touchpad-haptics","checked":"[[ \"$(dell-xps-touchpad-haptics get)\" == \"high\" ]]","action":"dell-xps-touchpad-haptics set high"},
  "trigger.hardware.touchscreen": {"icon":"󰆽","label":"Touchscreen","when":"fedory-hw-touchscreen","action":"fedory-toggle-touchscreen"},
  "trigger.hardware.tablet-keyboard": {"icon":"","label":"On-screen Keyboard","when":"[[ -f $HOME/.local/state/fedory/tablet/enabled ]]","action":"fedory-toggle-tablet-keyboard"},
  "trigger.hardware.tablet-rotation": {"icon":"󰑓","label":"Automatic Rotation","when":"[[ -f $HOME/.local/state/fedory/tablet/enabled ]] && fedory-hw-accelerometer","action":"fedory-toggle-tablet-rotation"},
  "trigger.reminder.set": {"icon":"󰢌","label":"Set one","aliases":["reminder-set","remind"],"action":"fedory-reminder -i"},
  "trigger.reminder.show": {"icon":"󰢌","label":"Show all","action":"fedory-reminder show"},
  "trigger.reminder.clear": {"icon":"󰢌","label":"Clear all","action":"fedory-reminder clear"},
  "trigger.share.clipboard": {"icon":"","label":"Clipboard","action":"fedory-menu-share clipboard"},
  "trigger.share.file": {"icon":"","label":"File","action":"xdg-terminal-exec --app-id=org.fedory.terminal bash -c 'fedory-menu-share file'"},
  "trigger.share.folder": {"icon":"","label":"Folder","action":"xdg-terminal-exec --app-id=org.fedory.terminal bash -c 'fedory-menu-share folder'"},
  "trigger.share.receive": {"icon":"󰥦","label":"Receive","action":"uwsm app -- localsend"},
  "trigger.toggle.idle-lock": {"icon":"󰅶","label":"Stay Awake","action":"fedory-toggle-idle"},
  "trigger.toggle.notifications": {"icon":"󰂛","label":"Notifications","action":"fedory-toggle-notification-silencing"},
  "trigger.toggle.screensaver": {"icon":"󱄄","label":"Screensaver","action":"fedory-toggle-screensaver"},
  "trigger.toggle.nightlight": {"icon":"󰔎","label":"Nightlight","action":"fedory-toggle-nightlight"},
  "trigger.toggle.top-bar": {"icon":"󰍜","label":"Menu Bar","action":"fedory-toggle-bar"},
  "trigger.toggle.workspace-layout": {"icon":"󱂬","label":"Workspace Layout","action":"fedory-hyprland-workspace-layout-toggle"},
  "trigger.toggle.window-gaps": {"icon":"","label":"Window Gaps","action":"fedory-hyprland-window-gaps-toggle"},
  "trigger.toggle.one-window-ratio": {"icon":"","label":"1-Window Ratio","action":"fedory-hyprland-window-single-square-aspect-toggle"},

  // Style
  "style.theme": {"icon":"󰸌","label":"Theme","aliases":["theme","themes"],"action":"theme=$(fedory-theme-switcher); [[ -n $theme ]] && fedory-theme-set \"$theme\""},
  "style.unlock": {"icon":"󰟵","label":"Unlock","aliases":["unlock"],"action":"unlock=$(fedory-plymouth-switcher); if [[ $unlock == default ]]; then fedory-launch-floating-terminal-with-presentation fedory-plymouth-reset; elif [[ -n $unlock ]]; then fedory-launch-floating-terminal-with-presentation \"fedory-plymouth-set-by-theme '$unlock'\"; fi"},
  "style.background": {"icon":"","label":"Background","aliases":["background","wallpaper"],"action":"background=$(fedory-theme-bg-switcher); [[ -n $background ]] && fedory-theme-bg-set \"$background\""},
  "style.font": {"icon":"","label":"Font","provider":"fonts"},
  "style.bar": {"icon":"󰍜","label":"Menu Bar"},
  "style.bar.position": {"icon":"","label":"Position"},
  "style.bar.transparency": {"icon":"󰂵","label":"Transparency","action":"fedory-bar transparent toggle"},
  "style.hyprland": {"icon":"","label":"Hyprland","action":"fedory-launch-config-editor \"$HOME/.config/hypr/looknfeel.lua\""},
  "style.screensaver": {"icon":"󱄄","label":"Screensaver"},
  "style.about": {"icon":"","label":"About"},
  "style.bar.position.top": {"icon":"󰁝","label":"Top","action":"fedory-bar position top"},
  "style.bar.position.bottom": {"icon":"󰁅","label":"Bottom","action":"fedory-bar position bottom"},
  "style.bar.position.left": {"icon":"󰁍","label":"Left","action":"fedory-bar position left"},
  "style.bar.position.right": {"icon":"󰁔","label":"Right","action":"fedory-bar position right"},
  "style.about.text": {"icon":"","label":"Edit Text","action":"fedory-branding-about text"},
  "style.about.image": {"icon":"","label":"Set From Image","action":"fedory-branding-about image"},
  "style.about.default": {"icon":"","label":"Restore Default","action":"fedory-branding-about reset"},
  "style.screensaver.text": {"icon":"","label":"Edit Text","action":"fedory-branding-screensaver text"},
  "style.screensaver.image": {"icon":"","label":"Set From Image","action":"fedory-branding-screensaver image"},
  "style.screensaver.default": {"icon":"","label":"Restore Default","action":"fedory-branding-screensaver reset"},

  // Setup
  "setup.monitors": {"icon":"󰍹","label":"Monitors","action":"fedory-launch-config-editor \"$HOME/.config/hypr/monitors.lua\""},
  "setup.keybindings": {"icon":"","label":"Keybindings","when":"[[ -f ~/.config/hypr/bindings.lua ]]","action":"fedory-launch-config-editor \"$HOME/.config/hypr/bindings.lua\""},
  "setup.input": {"icon":"","label":"Input","when":"[[ -f ~/.config/hypr/input.lua ]]","action":"fedory-launch-config-editor \"$HOME/.config/hypr/input.lua\""},
  "setup.tablet": {"icon":"󰓶","label":"Tablet Profile","when":"fedory-hw-tablet"},
  "setup.tablet.enable": {"icon":"󰄬","label":"Enable","when":"[[ ! -f $HOME/.local/state/fedory/tablet/enabled ]]","action":"fedory-launch-floating-terminal-with-presentation 'fedory-setup-tablet enable'"},
  "setup.tablet.status": {"icon":"","label":"Status","when":"[[ -f $HOME/.local/state/fedory/tablet/enabled ]]","action":"fedory-launch-floating-terminal-with-presentation 'fedory-setup-tablet status'"},
  "setup.tablet.disable": {"icon":"󰅖","label":"Disable","when":"[[ -f $HOME/.local/state/fedory/tablet/enabled ]]","action":"fedory-launch-floating-terminal-with-presentation 'fedory-setup-tablet disable'"},
  "setup.network": {"icon":"󰛳","label":"Network","aliases":["network"]},
  "setup.network.dns": {"icon":"󰇖","label":"DNS","aliases":["dns"]},
  "setup.network.dns.dhcp": {"icon":"󰩟","label":"DHCP","checked":"[[ \"$(fedory-dns)\" == \"DHCP\" ]]","action":"fedory-dns DHCP"},
  "setup.network.dns.cloudflare": {"icon":"󰅟","label":"Cloudflare","checked":"[[ \"$(fedory-dns)\" == \"Cloudflare\" ]]","action":"fedory-dns Cloudflare"},
  "setup.network.dns.google": {"icon":"󰊭","label":"Google","checked":"[[ \"$(fedory-dns)\" == \"Google\" ]]","action":"fedory-dns Google"},
  "setup.network.dns.custom": {"icon":"","label":"Custom","checked":"[[ \"$(fedory-dns)\" == \"Custom\" ]]","action":"fedory-launch-floating-terminal-with-presentation 'fedory-dns Custom'"},
  "setup.network.qr": {"icon":"󰐲","label":"QR Code","aliases":["wifi-qr"],"when":"[[ $(fedory-network-status) == wifi* ]]","action":"fedory-shell fedory.network showQr"},
  "setup.network.speedtest": {"icon":"󰓅","label":"Speed Test","aliases":["speedtest","speed-test"],"action":"fedory-shell fedory.network speedTest"},
  "setup.default": {"icon":"","label":"Defaults","aliases":["default","defaults"]},
  "setup.default.browser": {"icon":"","label":"Browser"},
  "setup.default.browser.chromium": {"icon":"","label":"Chromium","when":"fedory-cmd-present chromium","checked":"[[ \"$(fedory-default-browser)\" == \"chromium\" ]]","action":"fedory-default-browser chromium"},
  "setup.default.browser.chrome": {"icon":"󰊯","label":"Chrome","when":"fedory-cmd-present google-chrome-stable","checked":"[[ \"$(fedory-default-browser)\" == \"chrome\" ]]","action":"fedory-default-browser chrome"},
  "setup.default.browser.brave": {"icon":"󰖟","label":"Brave","when":"fedory-cmd-present brave-browser","checked":"[[ \"$(fedory-default-browser)\" == \"brave\" ]]","action":"fedory-default-browser brave"},
  "setup.default.browser.edge": {"icon":"󰇩","label":"Edge","when":"fedory-cmd-present microsoft-edge-stable","checked":"[[ \"$(fedory-default-browser)\" == \"edge\" ]]","action":"fedory-default-browser edge"},
  "setup.default.browser.firefox": {"icon":"","label":"Firefox","when":"fedory-cmd-present firefox","checked":"[[ \"$(fedory-default-browser)\" == \"firefox\" ]]","action":"fedory-default-browser firefox"},
  "setup.default.browser.zen": {"icon":"󰖟","label":"Zen","when":"flatpak info app.zen_browser.zen","checked":"[[ \"$(fedory-default-browser)\" == \"zen\" ]]","action":"fedory-default-browser zen"},
  "setup.default.terminal": {"icon":"","label":"Terminal"},
  "setup.default.terminal.alacritty": {"icon":"","label":"Alacritty","when":"fedory-cmd-present alacritty","checked":"[[ \"$(fedory-default-terminal)\" == \"alacritty\" ]]","action":"fedory-default-terminal alacritty"},
  "setup.default.terminal.foot": {"icon":"","label":"Foot","when":"fedory-cmd-present foot","checked":"[[ \"$(fedory-default-terminal)\" == \"foot\" ]]","action":"fedory-default-terminal foot"},
  "setup.default.terminal.ghostty": {"icon":"","label":"Ghostty","when":"fedory-cmd-present ghostty","checked":"[[ \"$(fedory-default-terminal)\" == \"ghostty\" ]]","action":"fedory-default-terminal ghostty"},
  "setup.default.terminal.kitty": {"icon":"","label":"Kitty","when":"fedory-cmd-present kitty","checked":"[[ \"$(fedory-default-terminal)\" == \"kitty\" ]]","action":"fedory-default-terminal kitty"},
  "setup.default.editor": {"icon":"","label":"Editor"},
  "setup.default.editor.neovim": {"icon":"","label":"Neovim","when":"fedory-cmd-present nvim","checked":"[[ \"$(fedory-default-editor)\" == \"nvim\" ]]","action":"fedory-default-editor nvim"},
  "setup.default.editor.vscode": {"icon":"","label":"VSCode","when":"fedory-cmd-present code","checked":"[[ \"$(fedory-default-editor)\" == \"code\" ]]","action":"fedory-default-editor code"},
  "setup.default.editor.cursor": {"icon":"","label":"Cursor","when":"fedory-cmd-present cursor","checked":"[[ \"$(fedory-default-editor)\" == \"cursor\" ]]","action":"fedory-default-editor cursor"},
  "setup.default.editor.zed": {"icon":"","label":"Zed","when":"fedory-cmd-present zeditor","checked":"[[ \"$(fedory-default-editor)\" == \"zeditor\" ]]","action":"fedory-default-editor zed"},
  "setup.default.editor.sublime": {"icon":"","label":"Sublime Text","when":"fedory-cmd-present sublime_text","checked":"[[ \"$(fedory-default-editor)\" == \"sublime_text\" ]]","action":"fedory-default-editor sublime_text"},
  "setup.default.editor.helix": {"icon":"","label":"Helix","when":"fedory-cmd-present helix","checked":"[[ \"$(fedory-default-editor)\" == \"helix\" ]]","action":"fedory-default-editor helix"},
  "setup.default.editor.vim": {"icon":"","label":"Vim","when":"fedory-cmd-present vim","checked":"[[ \"$(fedory-default-editor)\" == \"vim\" ]]","action":"fedory-default-editor vim"},
  "setup.default.editor.emacs": {"icon":"","label":"Emacs","when":"fedory-cmd-present emacs","checked":"[[ \"$(fedory-default-editor)\" == \"emacs\" ]]","action":"fedory-default-editor emacs"},
  "setup.security": {"icon":"","label":"Security"},
  "setup.config": {"icon":"","label":"Config"},
  "setup.security.fingerprint": {"icon":"󰈷","label":"Fingerprint","when":"fedory-hw-fingerprint","action":"fedory-launch-floating-terminal-with-presentation fedory-setup-security-fingerprint"},
  "setup.security.fido2": {"icon":"","label":"Fido2","action":"fedory-launch-floating-terminal-with-presentation fedory-setup-security-fido2"},
  "setup.security.sshd": {"icon":"󰣀","label":"SSHD","action":"fedory-launch-floating-terminal-with-presentation fedory-setup-security-sshd"},
  "setup.security.passwordless-sudo": {"icon":"󰟵","label":"Passwordless Sudo","action":"fedory-launch-floating-terminal-with-presentation fedory-sudo-passwordless"},
  "setup.config.hyprland": {"icon":"","label":"Hyprland","action":"fedory-launch-config-editor \"$HOME/.config/hypr/hyprland.lua\""},
  "setup.config.hyprsunset": {"icon":"","label":"Hyprsunset","action":"fedory-launch-config-editor ~/.config/hypr/hyprsunset.conf && fedory-restart-hyprsunset"},
  "setup.config.xcompose": {"icon":"󰞅","label":"XCompose","action":"fedory-launch-config-editor ~/.XCompose && fedory-restart-xcompose"},
  "setup.default.agent": {"icon":"󰚩","label":"Agent"},
  "setup.default.agent.claude": {"icon":"󰦔","label":"Claude","checked":"[[ \"$(fedory-default-agent)" == \"claude\" ]]","action":"fedory-default-agent claude"},
  "setup.default.agent.codex": {"icon":"","iconFont":"fedory","label":"Codex","checked":"[[ \"$(fedory-default-agent)" == \"codex\" ]]","action":"fedory-default-agent codex"},
  "setup.default.agent.copilot": {"icon":"󰒸","label":"Copilot","checked":"[[ \"$(fedory-default-agent)" == \"copilot\" ]]","action":"fedory-default-agent copilot"},
  "setup.default.agent.crush": {"icon":"󰋑","label":"Crush","checked":"[[ \"$(fedory-default-agent)" == \"crush\" ]]","action":"fedory-default-agent crush"},
  "setup.default.agent.gemini": {"icon":"󰫢","label":"Gemini","checked":"[[ \"$(fedory-default-agent)" == \"gemini\" ]]","action":"fedory-default-agent gemini"},
  "setup.default.agent.grok": {"icon":"","iconFont":"fedory","label":"Grok","checked":"[[ \"$(fedory-default-agent)" == \"grok\" ]]","action":"fedory-default-agent grok"},
  "setup.default.agent.omp": {"icon":"","iconFont":"fedory","label":"omp","checked":"[[ \"$(fedory-default-agent)" == \"omp\" ]]","action":"fedory-default-agent omp"},
  "setup.default.agent.opencode": {"icon":"","iconFont":"fedory","label":"OpenCode","checked":"[[ \"$(fedory-default-agent)" == \"opencode\" ]]","action":"fedory-default-agent opencode"},
  "setup.default.agent.pi": {"icon":"","iconFont":"fedory","label":"Pi","checked":"[[ \"$(fedory-default-agent)" == \"pi\" ]]","action":"fedory-default-agent pi"},
  "setup.default.plugin": {"icon":"󰐱","label":"Plugins","aliases":["plugin","plugins"]},
  "setup.default.plugin.enable": {"icon":"󰄬","label":"Enable Plugin","action":"fedory-menu-plugin enable"},
  "setup.default.plugin.disable": {"icon":"󰅖","label":"Disable Plugin","action":"fedory-menu-plugin disable"},
  "setup.default.plugin.add": {"icon":"󰖟","label":"Add Plugin","action":"fedory-launch-floating-terminal-with-presentation 'fedory-plugin-add'"}},
  "setup.default.plugin.clone": {"icon":"󰆏","label":"Clone Plugin","action":"fedory-menu-plugin clone"},
  "setup.default.plugin.remove": {"icon":"󰭌","label":"Remove Plugin","when":"compgen -G \"$HOME/.config/fedory/plugins/*/manifest.json\"","action":"fedory-menu-plugin remove"},

  // Install
  "install.package": {"icon":"󰣇","label":"Package","action":"xdg-terminal-exec --app-id=org.fedory.terminal fedory-pkg-install"},
  "install.webapp": {"icon":"","label":"Web App","action":"fedory-launch-floating-terminal-with-presentation fedory-webapp-install"},
  "install.tui": {"icon":"","label":"TUI","action":"fedory-launch-floating-terminal-with-presentation fedory-tui-install"},
  "install.service": {"icon":"","label":"Service"},
  "install.style": {"icon":"","label":"Style"},
  "install.style.theme": {"icon":"󰸌","label":"Theme","action":"fedory-launch-floating-terminal-with-presentation fedory-theme-install"},
  "install.style.background": {"icon":"","label":"Background","action":"fedory-theme-bg-install"},
  "install.style.font": {"icon":"","label":"Font"},
  "install.style.font.cascadia": {"icon":"","label":"Cascadia Mono","action":"fedory-install-font 'Cascadia Mono' cascadia-mono-nf-fonts 'CaskaydiaMono Nerd Font'"},
  "install.style.font.fira": {"icon":"","label":"Fira Code","action":"fedory-install-font 'Fira Code' fira-code-fonts 'Fira Code'"},
  "install.style.font.bitstream": {"icon":"","label":"Bitstream Vera Mono","action":"fedory-install-font 'Bitstream Vera Mono' bitstream-vera-sans-mono-fonts 'Bitstream Vera Sans Mono'"},
  "install.development": {"icon":"󰵮","label":"Development"},
  "install.editor": {"icon":"","label":"Editor"},
  "install.terminal": {"icon":"","label":"Terminal"},
  "install.browser": {"icon":"󰒘","label":"Browser"},
  "install.gaming": {"icon":"","label":"Gaming"},
  "install.windows": {"icon":"󰍲","label":"Windows","when":"[[ ! -f $HOME/.local/share/applications/windows-vm.desktop ]]","action":"fedory-launch-floating-terminal-with-presentation 'fedory-windows-vm install'"},
  "install.browser.chrome": {"icon":"","label":"Chrome","when":"! rpm -q google-chrome-stable","action":"fedory-launch-floating-terminal-with-presentation 'fedory-install-browser chrome'"},
  "install.browser.edge": {"icon":"󰇩","label":"Edge","when":"! rpm -q microsoft-edge-stable","action":"fedory-launch-floating-terminal-with-presentation 'fedory-install-browser edge'"},
  "install.browser.brave": {"icon":"","label":"Brave","when":"! rpm -q brave-browser","action":"fedory-launch-floating-terminal-with-presentation 'fedory-install-browser brave'"},
  "install.browser.firefox": {"icon":"","label":"Firefox","when":"! fedory-pkg-present firefox","action":"fedory-launch-floating-terminal-with-presentation 'fedory-install-browser firefox'"},
